# Copy this file to .env and fill in the values you need.
# .env is gitignored; this example file is committed with EMPTY values only.

# Which LLM provider to use: groq | openrouter | ollama | gemini
LLM_PROVIDER=groq

# Exact model name for the chosen provider.
# Model names change often: check the provider's docs and record it in docs/decisions.md.
LLM_MODEL=

# API keys (only the provider you use needs a value)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Local Ollama server (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
