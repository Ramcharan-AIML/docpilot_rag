# Copy this file to .env and fill in the values you need.
# .env is gitignored; this example file is committed with EMPTY values only.

# Which LLM provider to use: groq | openrouter | ollama | gemini
LLM_PROVIDER=groq

# Exact model name for the chosen provider.
# Model names change often: check the provider's docs and record it in docs/decisions.md.
LLM_MODEL=

# API keys (only the provider you use needs a value)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Local Ollama server (no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Qdrant server in Docker (Phase 3, step 3.1). Start it with: docker compose up -d
# Leave empty to use local mode (a folder, one process at a time).
# 127.0.0.1, NOT localhost: on Windows "localhost" tries IPv6 (::1) first and waits ~2 s per
# request before falling back to IPv4 (measured 2026-10-21: 2046 ms vs 3 ms, D-050).
QDRANT_URL=http://127.0.0.1:6333

# Object storage (Phase 3, step 3.1b): SeaweedFS in Docker on the laptop.
# Make up your own two keys (any text); SeaweedFS and DocPilot both read them from here.
# On AWS (Phase 7) leave these EMPTY: real S3 + the machine's IAM role, no keys in files.
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_ENDPOINT_URL_DOCKER=http://seaweedfs:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=

# MLflow tracking server in Docker (step 3.1b). Empty = local file mlflow.db (CI uses that).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
