# ---------------------------------------------------------------
# Secrets: API keys must never reach git (Rule 6).
# .env.example (empty values) IS committed so others know what to set.
# ---------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Downloaded docs: license reasons, and the download script can
# recreate them. The ".gitkeep" exception keeps the empty folder in git.
# ---------------------------------------------------------------
data/docs/*
!data/docs/.gitkeep
data/code/
data/processed/

# ---------------------------------------------------------------
# Local vector and database files: large, binary, rebuilt by scripts
# ---------------------------------------------------------------
qdrant_local/
qdrant_storage/
*.sqlite
*.db
*.duckdb

# ---------------------------------------------------------------
# Models and caches: hundreds of MB, downloaded on demand
# ---------------------------------------------------------------
*.safetensors
*.bin
*.onnx
.cache/
hf_cache/

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------
# Editor and OS clutter
# ---------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
.DS_Store

# ---------------------------------------------------------------
# MLflow experiment tracking (D-036): local database and attached
# files; the results JSON in evals/results/ is the committed copy
# ---------------------------------------------------------------
mlflow.db
mlartifacts/
mlruns/

# User PDF uploads (D-060): personal files, never in git
data/uploads/

# React UI (D-061): installed packages and build output are rebuilt by npm
web/node_modules/
web/dist/

# ---------------------------------------------------------------
# Personal learning and tracking notes (learner's choice, 2026-10-23):
# kept on the laptop only, not part of the product on GitHub
# ---------------------------------------------------------------
# docs/interview/
# docs/teaching/
# docs/project_guide/
# docs/interview_notes.md
# docs/decisions.md
# docs/2_decisions.md
# docs/3_decisions.md
# docs/progress.md
# docs/2_progress.md
# docs/3_progress.md
# docs/failure_log_phase1.md
# docs/CHAT_CONTEXT.md
